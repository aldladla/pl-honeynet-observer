[Unit]
Description=Capture approved PL Honeynet code, configuration, and image baseline
After=docker.service honeynet-firewall.service
Requires=docker.service honeynet-firewall.service

[Service]
Type=oneshot
EnvironmentFile=/opt/pl-honeynet-observer/.env
Environment=HONEYPOT_PROJECT_DIR=/opt/pl-honeynet-observer
ExecStart=/usr/local/sbin/honeynet-baseline capture
