      "pluginVersion": "12.4.0",
      "targets": [
        {
          "datasource": {"type": "postgres", "uid": "pl-honeynet-postgres"},
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH events AS (SELECT * FROM grafana_safe.event_stream WHERE $__timeFilter(observed_at)), behavior_groups AS (SELECT event_type, count(*)::bigint AS event_count, count(DISTINCT session_id)::bigint AS session_count FROM events GROUP BY event_type) SELECT 'sensor' AS id, 'PL Honeynet' AS title, 'monitorowany sensor' AS \"subTitle\", count(DISTINCT session_id)::double precision AS \"mainStat\", count(*)::text || ' zdarzeń' AS \"secondaryStat\", '#5794f2' AS color FROM events UNION ALL SELECT 'behavior:' || event_type, CASE event_type WHEN 'connection_opened' THEN 'Połączenia' WHEN 'client_fingerprint' THEN 'Fingerprint klienta' WHEN 'login_attempt' THEN 'Logowania' WHEN 'command_input' THEN 'Polecenia' WHEN 'artifact_captured' THEN 'Artefakty' WHEN 'file_download_requested' THEN 'Próby transferu' WHEN 'connection_closed' THEN 'Zamknięcia' ELSE replace(event_type, '_', ' ') END, 'typ zachowania', event_count::double precision, session_count::text || ' sesji', CASE WHEN event_type IN ('artifact_captured','file_download_requested') THEN '#e24d42' WHEN event_type = 'command_input' THEN '#ff9830' WHEN event_type = 'login_attempt' THEN '#f2cc0c' ELSE '#73bf69' END FROM behavior_groups;",
          "refId": "nodes"
        },
        {
          "datasource": {"type": "postgres", "uid": "pl-honeynet-postgres"},
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH events AS (SELECT * FROM grafana_safe.event_stream WHERE $__timeFilter(observed_at)), behavior_groups AS (SELECT event_type, count(*)::bigint AS event_count FROM events GROUP BY event_type) SELECT 'sensor-behavior:' || event_type AS id, 'sensor' AS source, 'behavior:' || event_type AS target, event_count::double precision AS \"mainStat\" FROM behavior_groups;",
          "refId": "edges"
        }
      ],
      "title": "Mapa zachowań — sensor → obserwowane aktywności",
