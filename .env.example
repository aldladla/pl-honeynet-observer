# Skopiuj jako .env i ustaw losowe wartości. Pliku .env nie commitujemy.
POSTGRES_PASSWORD=change-me-to-a-long-random-value
DATABASE_URL=postgresql+psycopg://honeynet:change-me-to-a-long-random-value@db:5432/honeynet
SENSOR_ID=local-cowrie-01
# Niezależny losowy klucz HMAC; nie używaj hasła bazy.
REPORT_PSEUDONYM_KEY=change-me-before-sharing
DASHBOARD_EVENT_LIMIT=50000
# Lokalne bazy MMDB montowane tylko do odczytu w kontenerze aplikacji.
GEOIP_COUNTRY_DB_PATH=/geoip/server-country-ipv4.mmdb
GEOIP_ASN_DB_PATH=/geoip/origin-asn-ipv4.mmdb
# Bezpieczne domyślne: sensor pozostaje wyłącznie lokalny.
SENSOR_BIND_IP=127.0.0.1
SENSOR_PUBLIC_PORT=2222
# Zmień na yes dopiero po udokumentowaniu wszystkich PASS z docs/safety.md.
PUBLICATION_APPROVED=no
# Chwilowy skok CPU tylko ostrzega; kill switch uruchamia się po tylu
# kolejnych przekroczeniach progu w minutowych kontrolach.
HONEYPOT_CPU_BREACH_COUNT_LIMIT=3
# Maksymalny zapis pojedynczej próbki: 16 MiB. Cała kwarantanna jest
# monitorowana osobno i po osiągnięciu 2 GiB sensor zostaje odcięty.
COWRIE_DOWNLOAD_LIMIT_SIZE_BYTES=16777216
HONEYPOT_QUARANTINE_LIMIT_BYTES=2147483648
HONEYPOT_QUARANTINE_WARN_PERCENT=70
# Grafana jest dostępna wyłącznie przez localhost/tunel SSH. Użyj dwóch
# niezależnych losowych wartości; konto bazy ma dostęp tylko do grafana_safe.*.
GRAFANA_DB_PASSWORD=change-me-to-an-independent-long-random-value
GRAFANA_ADMIN_USER=honeynet-admin
GRAFANA_ADMIN_PASSWORD=change-me-to-an-independent-admin-password
GRAFANA_PORT=3000
# Lokalnie 3000; dla tunelu VPS używamy lokalnego portu przeglądarki 13000.
GRAFANA_ROOT_URL=http://127.0.0.1:3000
